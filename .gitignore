# =============================================================================
# Repositório público: versiona apenas o painel HTML (UI + scripts de sync).
# Dados sensíveis, planilhas e motor R ficam somente na máquina local.
# =============================================================================

# Ambientes e caches
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.Rhistory
.RData
.Rproj.user/

# Temporários Office / sistema
~$*
**/~$*
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.log
*.bak
*.swp
*.orig

# IDE / editor
.idea/
.vscode/
.cursor/
*.code-workspace

# Pastas locais de teste / resíduos
peona_painel/_out/
peona_painel/_tmp/
peona_painel/_scratch/
peona_app/
_APAGAR*/
_vazio_apagar/
_lixo*/
*.zip
*.tar.gz

# -----------------------------------------------------------------------------
# Motor de cálculo e entradas (não publicar)
