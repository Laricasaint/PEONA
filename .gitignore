/peona_ipasgo_v2.R
/peona_rumo_x_ipasgo.R
/PEONA_INPUT.xlsx
/Acompanhamento das Provisões.xlsx
/~$PEONA_INPUT.xlsx
/~$Acompanhamento das Provisões.xlsx
*.xlsx
*.xls
*.rds

# Saídas R espelhadas na raiz
/historico_consistencia.csv
/historico_consistencia.rds
/historico_consistencia.json
/historico_consistencia_auditoria.jsonl
/historico_backups/
/peona_rumo_x_ipasgo_pbi.csv
/peona_rumo_x_ipasgo_meta.json
/peona_serie_pbi.csv
/peona_resumo_mes_pbi.csv
/peona_consistencia_pbi.csv
/peona_triangulo_pbi.csv
/peona_data.js
/peona_data.json
/PEONA_Resultado_R.xlsx

# -----------------------------------------------------------------------------
# Payload do painel — CSVs/histórico locais; peona_data.js vai ao Pages
# -----------------------------------------------------------------------------
peona_painel/data/*
!peona_painel/data/.gitkeep
!peona_painel/data/peona_data.js
!peona_painel/data/historico_backups/
peona_painel/data/historico_backups/*
!peona_painel/data/historico_backups/.gitkeep
peona_painel/_validacao_r.log
peona_painel/_*.py
peona_painel/**/~$*
